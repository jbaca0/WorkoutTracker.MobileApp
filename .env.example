# Copy to .env.local for machine-local overrides. .env.local is gitignored; .env is NOT.
# Never put real credentials in .env.

EXPO_PUBLIC_SERVER_URL=http://localhost:5231

# Optional: enables the "Use dev account" button on the login screen.
# Only read when __DEV__ is true (see app/login.tsx). Put these in .env.local,
# never in .env, and point them at a local dev server's seeded user.
# EXPO_PUBLIC_DEV_EMAIL=dev@example.com
# EXPO_PUBLIC_DEV_PASSWORD=
